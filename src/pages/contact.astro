---
import Layout from '../layouts/Layout.astro';
import { site } from '../siteConfig';

const title = 'Demander un devis — Scan 3D LiDAR';
const description =
  "Formulaire de devis pour scan 3D LiDAR, Scan-to-BIM ou numérisation patrimoniale en Guadeloupe et aux Antilles. Réponse sous 24 h ouvrées, devis gratuit et sans engagement.";

const breadcrumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Contact', path: '/contact' },
];

const contactPointSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: `${site.url}/contact`,
  about: {
    '@type': 'Service',
    name: 'Devis scan 3D LiDAR Antilles',
    provider: { '@id': `${site.url}/#organization` },
  },
};
---

<Layout
  title={title}
  description={description}
  path="/contact"
  active="/contact"
  breadcrumbs={breadcrumbs}
  extraSchema={contactPointSchema}
>
  <main class="page-main">
    <section id="contact" class="devis-section">
      <div class="block">
        <header class="devis-hero">
          <div class="tag">IV — Demander un devis</div>
          <h1 class="page-title">Parlons de<br /><em>votre projet.</em></h1>
          <p class="page-lede">
            Quelques minutes pour nous écrire, une réponse humaine sous
            <strong>24 h ouvrées</strong> avec une première estimation. Pas de robot, pas de relance marketing.
          </p>
        </header>

        <div class="devis-layout">
          <form
            id="devis-form"
            class="devis-form contact-form"
            method="POST"
            action="https://formsubmit.co/contact@metrie-gp.fr"
          >
            <input type="hidden" name="_subject" value="Nouvelle demande de devis — Metrie GP" />
            <input type="hidden" name="_template" value="table" />
            {/* Le captcha renvoie une page intermédiaire incompatible avec l'envoi
                AJAX ci-dessous ; le honeypot _honey le remplace. */}
            <input type="hidden" name="_captcha" value="false" />
            <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

            <div class="field-row">
              <label class="field">
                <span>Nom complet <em>*</em></span>
                <input type="text" name="name" placeholder="Jean Dupont" required />
              </label>
              <label class="field">
                <span>Téléphone</span>
                <input type="tel" name="phone" placeholder="06 00 00 00 00" />
              </label>
            </div>

            <label class="field">
              <span>Email professionnel <em>*</em></span>
              <input type="email" name="email" placeholder="jean@entreprise.fr" required />
            </label>

            <div class="field-check-group">
              <span class="field-label">Type de projet <em>*</em></span>
              <div class="pills-wrap">
                <label class="check-pill"><input type="radio" name="project_type" value="appartement" required />Appartement</label>
                <label class="check-pill"><input type="radio" name="project_type" value="maison" />Maison</label>
                <label class="check-pill"><input type="radio" name="project_type" value="hangar-entrepot" />Hangar / Entrepôt</label>
                <label class="check-pill"><input type="radio" name="project_type" value="commerce" />Commerce</label>
                <label class="check-pill"><input type="radio" name="project_type" value="bureau" />Bureau</label>
                <label class="check-pill"><input type="radio" name="project_type" value="patrimoine" />Patrimoine</label>
                <label class="check-pill"><input type="radio" name="project_type" value="autre" />Autre</label>
              </div>
              <input
                type="text"
                name="project_type_autre"
                id="project-type-autre"
                class="field-precision"
                placeholder="Précisez le type de projet"
                style="margin-top:12px;display:none;"
              />
            </div>

            <div class="field-check-group">
              <span class="field-label">Livrables attendus <em>*</em></span>
              <div class="pills-wrap">
                <label class="check-pill"><input type="checkbox" name="service" value="releve-topo" />Visite virtuelle</label>
                <label class="check-pill"><input type="checkbox" name="service" value="scan-to-bim" />Nuage de point</label>
                <label class="check-pill"><input type="checkbox" name="service" value="patrimoine" />Modélisation archicad</label>
                <label class="check-pill"><input type="checkbox" name="service" value="industriel" />Plan, façades, coupes en DWG</label>
                <label class="check-pill"><input type="checkbox" name="service" value="autre" /><span>Autre</span></label>
              </div>
              <input
                type="text"
                name="service_autre"
                id="service-autre"
                class="field-precision"
                placeholder="Précisez le livrable attendu"
                style="margin-top:12px;display:none;"
              />
            </div>

            <label class="field">
              <span>Décrivez votre projet <em>*</em></span>
              <textarea name="message" rows="5" placeholder="Quel site ? quel livrable attendu ? contraintes particulières (site en exploitation, accès, délai) ?" required></textarea>
            </label>

            <label class="field check-consent">
              <input type="checkbox" name="consent" required />
              <span>J'accepte que mes données soient utilisées pour traiter cette demande de devis, conformément à la <a href="/confidentialite" target="_blank" rel="noopener">politique de confidentialité</a>. Elles ne seront ni cédées ni utilisées à des fins marketing. <em>*</em></span>
            </label>

            <div class="form-actions">
              <button type="submit" class="btn-primary">Envoyer ma demande</button>
              <div class="form-trust">
                <span>Réponse <strong>24 h</strong></span>
                <span class="trust-sep">·</span>
                <span>Devis <strong>gratuit</strong></span>
                <span class="trust-sep">·</span>
                <span>Sans <strong>engagement</strong></span>
              </div>
            </div>

            <p id="devis-status" class="form-status" role="status" aria-live="polite" hidden></p>
          </form>

          <aside class="devis-aside">
            <div class="aside-block">
              <span class="aside-label">Ou directement</span>
              <a href={`mailto:${site.email}`} class="aside-link">
                <span class="aside-k">Email</span>
                <span class="aside-v">{site.email}</span>
              </a>
              <span class="aside-k">Téléphone</span>
              {site.phoneDisplay.map((display, i) => (
                <a href={`tel:${site.phone[i]}`} class="aside-link">
                  <span class="aside-v">{display}</span>
                </a>
              ))}
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  

  <script is:inline>
    (function () {
      // Type de projet → champ "Autre" (radio)
      const projectAutre = document.getElementById('project-type-autre');
      if (projectAutre) {
        const radios = document.querySelectorAll('input[name="project_type"]');
        const syncProject = () => {
          const selected = document.querySelector('input[name="project_type"]:checked');
          const isAutre = selected && selected.value === 'autre';
          projectAutre.style.display = isAutre ? 'block' : 'none';
          projectAutre.required = !!isAutre;
          if (!isAutre) projectAutre.value = '';
        };
        radios.forEach((r) => r.addEventListener('change', syncProject));
        syncProject();
      }

      // Livrables attendus → champ "Autre" (checkbox)
      const serviceAutre = document.getElementById('service-autre');
      const autreCheckbox = document.querySelector('input[name="service"][value="autre"]');
      if (serviceAutre && autreCheckbox) {
        const syncService = () => {
          const isAutre = autreCheckbox.checked;
          serviceAutre.style.display = isAutre ? 'block' : 'none';
          serviceAutre.required = isAutre;
          if (!isAutre) serviceAutre.value = '';
        };
        autreCheckbox.addEventListener('change', syncService);
        syncService();
      }

      // Envoi de la demande de devis.
      //
      // L'attribut action reste en place : sans JavaScript, le navigateur
      // poste normalement vers FormSubmit et l'utilisateur voit leur page de
      // confirmation. Avec JavaScript, on intercepte pour rester sur le site,
      // MAIS on n'affiche « envoyé » que si FormSubmit a réellement accepté la
      // demande. Toute erreur est affichée avec un moyen de contact de repli,
      // pour ne plus jamais perdre silencieusement un prospect.
      const form = document.getElementById('devis-form');
      const status = document.getElementById('devis-status');
      if (!form || !status) return;

      const endpoint = form.action.replace(
        'https://formsubmit.co/',
        'https://formsubmit.co/ajax/'
      );

      form.addEventListener('submit', async (event) => {
        if (!form.reportValidity()) return;
        event.preventDefault();

        const button = form.querySelector('button[type=submit]');
        const label = button.innerHTML;
        button.disabled = true;
        button.innerHTML = 'Envoi en cours…';
        status.hidden = true;
        status.className = 'form-status';

        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          });
          const data = await response.json().catch(() => ({}));

          if (!response.ok || data.success === 'false' || data.success === false) {
            throw new Error(data.message || 'Envoi refusé');
          }

          form.classList.add('submitted');
          button.innerHTML = 'Demande envoyée ✓';
          status.className = 'form-status form-status-ok';
          status.textContent =
            'Merci, votre demande est bien partie. Nous revenons vers vous sous 24 h ouvrées.';
          status.hidden = false;
          form.reset();
        } catch (error) {
          button.disabled = false;
          button.innerHTML = label;
          status.className = 'form-status form-status-error';
          status.innerHTML =
            "L'envoi a échoué. Écrivez-nous directement à " +
            '<a href="mailto:contact@metrie-gp.fr">contact@metrie-gp.fr</a> ' +
            'ou appelez le <a href="tel:+33766176126">07 66 17 61 26</a>.';
          status.hidden = false;
        }
      });
    })();
  </script>
</Layout>
