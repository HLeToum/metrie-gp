---
import { navLinks } from '../siteConfig';

interface Props {
  variant?: 'light' | 'dark';
  active?: string;
}
const { variant = 'light', active = '' } = Astro.props;
const navClass = variant === 'dark' ? 'nav nav-dark' : 'nav';
---

<header class={navClass} id="topnav">
  <div class="nav-inner">
    <a href="/" class="logo">
      <span class="logo-text">Metrie GP</span>
    </a>
    <nav>
      {navLinks.map((l) => (
        <a href={l.href} class={active === l.href ? 'active' : ''}>{l.label}</a>
      ))}
      <a href="/contact" class={`nav-drawer-cta${active === '/contact' ? ' active' : ''}`}>Nous contacter</a>
    </nav>
    <div class="nav-actions">
      <a href="/contact" class={`nav-cta${active === '/contact' ? ' active' : ''}`}>Nous contacter</a>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Basculer le thème clair / sombre" title="Thème clair / sombre">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.5v2.4M12 19.1v2.4M4.6 4.6l1.7 1.7M17.7 17.7l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.6 19.4l1.7-1.7M17.7 6.3l1.7-1.7" />
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a6.5 6.5 0 1 0 10.5 10.5z" />
        </svg>
      </button>
      <button class="nav-burger" id="nav-burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="topnav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Light / dark theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    const meta = document.querySelector('meta[name="theme-color"]');
    const applyMeta = (theme: string) => {
      if (meta) meta.setAttribute('content', theme === 'light' ? '#f6f2e8' : '#02140a');
    };
    applyMeta(document.documentElement.dataset.theme || 'dark');
    themeToggle.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      applyMeta(next);
      try {
        localStorage.setItem('theme', next);
      } catch (e) {
        /* storage unavailable */
      }
    });
  }

  const topnav = document.getElementById('topnav');
  if (topnav) {
    window.addEventListener(
      'scroll',
      () => {
        topnav.classList.toggle('scrolled', window.scrollY > 40);
      },
      { passive: true },
    );

    const burger = document.getElementById('nav-burger');
    if (burger) {
      const close = () => {
        topnav.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('nav-open');
      };
      burger.addEventListener('click', () => {
        const isOpen = topnav.classList.toggle('open');
        burger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        document.body.classList.toggle('nav-open', isOpen);
      });
      topnav.querySelectorAll('nav a, .nav-cta').forEach((a) =>
        a.addEventListener('click', close),
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    }
  }
</script>
